APP_NAME=OpFin
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Kampala
APP_URL=http://localhost
OPFIN_ENABLE_DEMO_ROUTES=false

# CPay v2 is the only production money-movement boundary for OpFin.
# Use mock only in local/testing. Production must use cpay.
MOBILE_MONEY_PROVIDER=mock
MOBILE_MONEY_CURRENCY=UGX
CPAY_BASE_URL=
CPAY_MERCHANT_NUMBER=
CPAY_MERCHANT_ID=
# PEM value may be provided with literal \n characters; the adapter normalizes them at runtime.
CPAY_PRIVATE_KEY=
CPAY_CALLBACK_URL=
CPAY_CALLBACK_SECRET=
CPAY_CALLBACK_REPLAY_WINDOW_SECONDS=300
CPAY_ENVIRONMENT=sandbox
CPAY_COUNTRY=UG
CPAY_CURRENCY=UGX
CPAY_CHANNEL=
CPAY_MINOR_UNIT_EXPONENT=0
CPAY_TIMEOUT_SECONDS=30
CPAY_CONNECT_RETRIES=1
CPAY_RETRY_DELAY_MS=250
MOCK_MOBILE_MONEY_WEBHOOK_SECRET=

# Airtel is KYC-only in OpFin. Do not configure payment/disbursement credentials here.
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX

# Credit reference bureau
CRB_URL=
CRB_CLIENT_ID=
CRB_CLIENT_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# Production must use a dedicated managed PostgreSQL database.
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=opfin_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SANCTUM_TOKEN_EXPIRY=10080
CORS_ALLOWED_ORIGINS=http://localhost:3000
